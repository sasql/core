{
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["keyword.other", "support.function.aggregate.sasql"],
                "settings": {
                    "foreground": "#db7c74",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": ["string.quoted.double.sasql"],
                "settings": {
                    "foreground": "#7dc9f1"
                }
            },
            {
                "scope": ["constant.numeric.sasql"],
                "settings": {
                    "foreground": "#7ccc5c"
                }
            },
            {
                "scope": ["string.quoted.single.sasql"],
                "settings": {
                    "foreground": "#e4e487"
                }
            },
            {
                "scope": [
                    "keyword.operator.comparison.sasql",
                    "keyword.operator.star.sasql"
                ],
                "settings": {
                    "foreground": "#d6aaaa"
                }
            }
        ]
    }
}
